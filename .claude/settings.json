{
  "permissions": {
    "allowedTools": [
      "Read",
      "Write",
      "Edit",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(pytest *)",
      "Bash(python *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Write(*.env*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read f; case \"$f\" in *.ts|*.tsx|*.js|*.jsx) npx prettier --write \"$f\" 2>/dev/null;; *.py) black \"$f\" 2>/dev/null || ruff format \"$f\" 2>/dev/null;; esac; }"
          }
        ]
      }
    ]
  }
}